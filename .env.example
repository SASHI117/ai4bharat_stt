# Clients send: Authorization: Bearer <STT_API_KEY>
STT_API_KEY=change-me
# The model is gated: request access on Hugging Face first
HF_TOKEN=
# rnnt (more accurate) or ctc (faster)
STT_DECODE=rnnt
# Inference threads (default: all cores)
STT_THREADS=
STT_MAX_UPLOAD_MB=50
# 1 = load the model at startup instead of on the first request
STT_PRELOAD=1
